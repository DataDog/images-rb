FROM ghcr.io/datadog/images-rb/engines/ruby:3.2-musl

# mkmf configuration probes link against Ruby's static-library dependencies.
RUN apk add \
    binutils \
    clang \
    file \
    fortify-headers \
    gcc \
    gmp-dev \
    make \
    mariadb-connector-c-dev \
    musl-dev \
    postgresql-dev \
    sqlite-dev \
    zlib-dev \
    && ln -s "$(command -v clang)" /usr/local/bin/gcc
