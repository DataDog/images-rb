FROM ghcr.io/datadog/images-rb/engines/ruby:4.1-centos

RUN yum install -y epel-release \
    && yum install -y devtoolset-10-gcc clang make binutils file patch pkgconfig mariadb-devel postgresql-devel sqlite-devel \
    && printf '%s\n' \
        '#!/bin/bash' \
        'gcc_dir="$(dirname "$(/opt/rh/devtoolset-10/root/usr/bin/gcc -print-file-name=crtbegin.o)")"' \
        'args=()' \
        'for arg in "$@"; do' \
        '    case "$arg" in' \
        '        -fstack-protector-strong) args+=(-fstack-protector-all) ;;' \
        '        -mbranch-protection=pac-ret) ;;' \
        '        *) args+=("$arg") ;;' \
        '    esac' \
        'done' \
        'exec clang -B "$gcc_dir" -L "$gcc_dir" "${args[@]}"' \
        > /usr/local/bin/gcc \
    && chmod +x /usr/local/bin/gcc
