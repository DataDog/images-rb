# platforms: linux/x86_64

FROM ghcr.io/datadog/images-rb/engines/ruby:2.0-centos

RUN yum install -y epel-release \
    && yum install -y gcc clang make binutils file patch \
    && printf '%s\n' \
        '#!/bin/bash' \
        'gcc_dir="$(dirname "$(/usr/bin/gcc -print-file-name=crtbegin.o)")"' \
        'args=()' \
        'for arg in "$@"; do' \
        '    case "$arg" in' \
        '        -fstack-protector-strong) args+=(-fstack-protector-all) ;;' \
        '        *) args+=("$arg") ;;' \
        '    esac' \
        'done' \
        'exec clang -B "$gcc_dir" -L "$gcc_dir" "${args[@]}"' \
        > /usr/local/bin/gcc \
    && chmod +x /usr/local/bin/gcc
