FROM ghcr.io/datadog/images-rb/engines/ruby:2.4-gnu

RUN apt-get install -y \
    binutils \
    file \
    make \
    libc6-dev \
    libffi-dev \
    libssl-dev \
    libyaml-dev \
    zlib1g-dev \
    clang \
    --no-install-recommends

RUN printf '%s\n' '#!/bin/sh' 'exec clang -fdeclspec "$@"' > /usr/local/bin/gcc \
    && chmod +x /usr/local/bin/gcc
