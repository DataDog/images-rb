# append-tags: clang
# append-tags: gnu
# append-tags: gnu-clang

# Debian 13 provides Clang 19 on both supported architectures.
FROM public.ecr.aws/docker/library/debian:13

ARG REPRO_RUN_KEY=0

RUN echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries
# Keep the package index tied to the same cache key as the other runtime images.
RUN true "${REPRO_RUN_KEY}" && apt-get update

RUN apt-get install -y locales tzdata --no-install-recommends \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

COPY <<GEMRC /usr/local/etc/gemrc
install: --no-document
update: --no-document
GEMRC

ENV LANG="en_US.UTF-8" \
    LANGUAGE="en_US:en" \
    RUBY_MAJOR="3.4" \
    RUBY_VERSION="3.4.7" \
    RUBY_DOWNLOAD_SHA256="db425a86f6e07546957578f4946cc700a91e7fd51115a86c56e096f30e0530c7" \
    OPENSSL_VERSION="3.5.9" \
    OPENSSL_DOWNLOAD_SHA256="603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a" \
    LIBYAML_VERSION="0.2.5" \
    LIBYAML_DOWNLOAD_SHA256="c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4"

RUN apt-get install -y \
    autoconf \
    bison \
    binutils \
    ca-certificates \
    clang-19 \
    curl \
    file \
    git \
    libc6-dev \
    libclang-rt-19-dev \
    libffi-dev \
    libgdbm-dev \
    libmariadb-dev \
    libmariadb-dev-compat \
    libncurses-dev \
    libpq-dev \
    libreadline-dev \
    libsqlite3-dev \
    llvm-19 \
    make \
    patch \
    perl \
    pkg-config \
    rustc \
    xz-utils \
    zlib1g-dev \
    --no-install-recommends

RUN ln -s /usr/bin/clang-19 /usr/local/bin/clang \
    && ln -s /usr/bin/clang++-19 /usr/local/bin/clang++ \
    && ln -s /usr/bin/llvm-symbolizer-19 /usr/local/bin/llvm-symbolizer

# Some extensions invoke gcc directly, bypassing Ruby's configured compiler.
RUN printf '%s\n' '#!/bin/sh' 'exec clang -fdeclspec "$@"' > /usr/local/bin/gcc \
    && chmod +x /usr/local/bin/gcc

# Keep instrumented libraries private: system utilities must use the distro's
# libraries, while Ruby and extensions need matching headers and ASan coverage.
ENV PKG_CONFIG_PATH=/opt/asan/lib/pkgconfig

RUN <<SHELL
set -eux

curl -fL --retry 3 -o openssl.tar.gz "https://github.com/openssl/openssl/releases/download/openssl-$OPENSSL_VERSION/openssl-$OPENSSL_VERSION.tar.gz"
echo "$OPENSSL_DOWNLOAD_SHA256 *openssl.tar.gz" | sha256sum --check --strict
mkdir -p /usr/src/openssl
tar -xzf openssl.tar.gz -C /usr/src/openssl --strip-components=1
rm openssl.tar.gz

cd /usr/src/openssl
CC=clang ./Configure \
    --prefix=/opt/asan \
    --libdir=lib \
    --openssldir=/usr/lib/ssl \
    shared no-tests no-apps \
    -fsanitize=address -fno-omit-frame-pointer -g -O3 \
    -Wl,-rpath,/opt/asan/lib
make -j "$(nproc)"
make install_dev
rm /opt/asan/lib/*.a

cd /
rm -rf /usr/src/openssl
SHELL

RUN <<SHELL
set -eux

curl -fL --retry 3 -o yaml.tar.gz "https://pyyaml.org/download/libyaml/yaml-$LIBYAML_VERSION.tar.gz"
echo "$LIBYAML_DOWNLOAD_SHA256 *yaml.tar.gz" | sha256sum --check --strict
mkdir -p /usr/src/libyaml
tar -xzf yaml.tar.gz -C /usr/src/libyaml --strip-components=1
rm yaml.tar.gz

cd /usr/src/libyaml
# Configure runs instrumented probes; leak scanning needs ptrace permissions
# unavailable inside ordinary Docker builds.
export ASAN_OPTIONS=detect_leaks=0
./configure \
    --prefix=/opt/asan \
    --disable-static \
    --enable-shared \
    CC=clang \
    CFLAGS='-fsanitize=address -fno-omit-frame-pointer -g -O3' \
    LDFLAGS='-Wl,-rpath,/opt/asan/lib' \
    || { cat config.log; exit 1; }
make -j "$(nproc)"
make install

cd /
rm -rf /usr/src/libyaml
SHELL

RUN <<SHELL
set -eux

curl -fL --retry 3 -o ruby.tar.xz "https://cache.ruby-lang.org/pub/ruby/$RUBY_MAJOR/ruby-$RUBY_VERSION.tar.xz"
echo "$RUBY_DOWNLOAD_SHA256 *ruby.tar.xz" | sha256sum --check --strict
mkdir -p /usr/src/ruby
tar -xJf ruby.tar.xz -C /usr/src/ruby --strip-components=1
rm ruby.tar.xz

cd /usr/src/ruby
autoconf
export ASAN_OPTIONS=detect_leaks=0

# Follow ruby/ruby-dev-builder's ASan configuration. M:N threading is disabled
# for Clang's TLS incompatibility: https://bugs.ruby-lang.org/issues/20243.
# Configure-time flags persist in RbConfig and instrument mkmf extensions too.
./configure \
    --build="$(clang -dumpmachine)" \
    --disable-install-doc \
    --enable-shared \
    --enable-yjit \
    --with-openssl-dir=/opt/asan \
    --with-libyaml-dir=/opt/asan \
    CC=clang \
    CXX=clang++ \
    cppflags='-DENABLE_PATH_CHECK=0 -DRUBY_DEBUG=1 -DVM_CHECK_MODE=1 -DUSE_MN_THREADS=0' \
    optflags='-O3 -fno-omit-frame-pointer' \
    debugflags='-fsanitize=address -g' \
    cflags='-I/opt/asan/include' \
    cxxflags='-fsanitize=address -fno-omit-frame-pointer -g -O3 -I/opt/asan/include' \
    LDFLAGS='-fsanitize=address -L/opt/asan/lib -Wl,-rpath,/opt/asan/lib -Wl,-z,relro,-z,now'
make -j "$(nproc)"
make install
ldconfig

cd /
rm -rf /usr/src/ruby

if dpkg -l ruby 2>/dev/null | grep -q '^ii'; then exit 1; fi

gem update --system 4.0.19
gem install bundler --version 4.0.19

ruby --version
gem --version
bundle --version
SHELL

ENV GEM_HOME=/usr/local/bundle
ENV BUNDLE_SILENCE_ROOT_WARNING=1 \
    BUNDLE_APP_CONFIG="$GEM_HOME"
ENV PATH=$GEM_HOME/bin:$PATH

RUN mkdir -p "$GEM_HOME" && chmod 1777 "$GEM_HOME"

CMD [ "irb" ]
