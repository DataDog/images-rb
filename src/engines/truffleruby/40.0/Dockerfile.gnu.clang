FROM ghcr.io/datadog/images-rb/engines/truffleruby:40.0-gnu

RUN apt-get install -y \
    binutils \
    file \
    make \
    pkg-config \
    libc6-dev \
    libmariadb-dev \
    libmariadb-dev-compat \
    libpq-dev \
    libsqlite3-dev \
    clang \
    --no-install-recommends

# RbConfig names the GNU tools even when building extensions with Clang.
RUN ln -s /usr/bin/clang /usr/local/bin/gcc \
    && ln -s /usr/bin/clang++ /usr/local/bin/g++ \
    && ln -s /usr/bin/ar /usr/local/bin/gcc-ar \
    && ln -s /usr/bin/ranlib /usr/local/bin/gcc-ranlib
